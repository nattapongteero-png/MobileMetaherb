+
+
+extension View {
+  /// iPadOS 18+ renders TabView's bar at the top (or as a sidebar). The app
+  /// wants the iPhone-style bottom tab bar everywhere, so force the compact
+  /// horizontal size class for the tab view subtree on pads.
+  @ViewBuilder
+  func forceCompactTabBarOnPad() -> some View {
+    #if os(iOS)
+      if UIDevice.current.userInterfaceIdiom == .pad {
+        self.environment(\.horizontalSizeClass, .compact)
+      } else {
+        self
+      }
+    #else
+      self
+    #endif
+  }
+}
